{
  "manifest_version": 3,
  "name": "Crypto Copilot Central AI",
  "version": "4.0.2",
  "description": "Premium AI copilot for X powered by a centralized Cloudflare Worker",
  "permissions": [],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://crypto-copilot-api.diako1.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Crypto Copilot Central AI",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content-final.js"],
      "run_at": "document_idle"
    }
  ]
}
