{
  "manifest_version": 3,
  "name": "Crypto Copilot",
  "version": "2.0.0",
  "description": "Premium AI copilot for crypto replies, translation and content creation on X",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://x.com/*", "https://openrouter.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
