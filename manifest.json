{
  "manifest_version": 3,
  "name": "Crypto Copilot",
  "version": "2.2.3",
  "description": "Premium AI copilot for natural crypto replies and content creation on X",
  "permissions": [],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://crypto-copilot-api.diako1.workers.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Crypto Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content-v223.js"],
      "run_at": "document_idle"
    }
  ]
}