{
  "manifest_version": 2,
  "name": "Crypto Copilot Mobile",
  "version": "1.0.0",
  "description": "AI assistant for X with Smart Reply, Translate, Thread and Custom Tweet.",
  "icons": {
    "16": "../icon16.png",
    "48": "../icon48.png",
    "128": "../icon128.png"
  },
  "permissions": [
    "storage",
    "https://openrouter.ai/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "crypto-copilot-mobile@ediakoe.com",
      "strict_min_version": "120.0"
    }
  }
}
